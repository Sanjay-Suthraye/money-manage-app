# Secrets — never commit
api_keys.env
.env
*.env
!requirements.env

# Android signing — a leaked upload key lets someone else ship as you, and
# deploy.sh pushes main to GitHub. These must be ignored BEFORE any key exists.
*.keystore
*.jks
key.properties
*.aab
*.apk

# Data (includes personal finance exports)
data/
*.db
*.db-wal
*.db-shm
*.xlsx
*.xls
*.csv

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/

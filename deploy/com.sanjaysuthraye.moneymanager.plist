<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sanjaysuthraye.moneymanager</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/sanjaysuthraye/miniconda3/envs/money/bin/uvicorn</string>
        <string>backend.main:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8010</string>
    </array>
    <!-- WorkingDirectory must be the repo root: uvicorn imports "backend.main",
         so a wrong path here fails with ModuleNotFoundError and KeepAlive turns
         that into an endless respawn loop. Keep in sync if the project moves. -->
    <key>WorkingDirectory</key>
    <string>/Users/sanjaysuthraye/anaconda_projects/3. Finance Apps/money_manager</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Logs stay inside the project: data/logs/ (gitignored via data/). The app
         writes its own rotated logs there too (backend/logging_setup.py); this
         only catches startup/crash output before logging is configured. -->
    <key>StandardOutPath</key>
    <string>/Users/sanjaysuthraye/anaconda_projects/3. Finance Apps/money_manager/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sanjaysuthraye/anaconda_projects/3. Finance Apps/money_manager/data/logs/launchd.log</string>
</dict>
</plist>

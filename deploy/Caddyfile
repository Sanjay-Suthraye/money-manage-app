# Caddy reverse proxy for money.skybolabs.com (-> /etc/caddy/Caddyfile).
# Reload after editing:  sudo systemctl reload caddy
# Watch issuance with:   journalctl -u caddy -f
#
# TRANSITION: two site blocks run side by side on purpose.
#   * money.skybolabs.com — the real site. Normal Let's Encrypt certs (90 days,
#     renewed at 60) because a DNS name can use the standard ACME profile.
#   * https://13.234.241.7 — the legacy bare-IP site the three existing users
#     have installed as a PWA. Let's Encrypt IP certs only come in the
#     "shortlived" profile (~6-day certs, renewed every ~4 days), which is a
#     2-day error budget: one failed renewal bricks every install within a week.
#     That is precisely why it is being retired.
#
# DELETE the IP block once everyone has moved to the hostname — it is the single
# riskiest thing in this file. Android App Links CANNOT verify an IP literal, so
# the TWA depends entirely on the hostname block.

{
	email yashnimavat0@gmail.com
	# Clients never send SNI for IP URLs, and behind Lightsail NAT the
	# instance's local address is the PRIVATE ip — so without this, Caddy
	# can't pick the cert ("no certificate available for '172.26.x.x'").
	# Remove together with the IP block below.
	default_sni 13.234.241.7
}

(app) {
	# flush_interval -1: never buffer — keeps the chat SSE stream incremental.
	# Do NOT add `encode gzip` here: compressing text/event-stream defeats the
	# incremental flush this exists to protect.
	reverse_proxy 127.0.0.1:8010 {
		flush_interval -1
	}
}

money.skybolabs.com {
	import app
}

# --- legacy, delete after the cutover ---------------------------------------
https://13.234.241.7 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import app
}
